# Required for upload extraction and syllabus Q&A. Create one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Gemini 3.5 Flash-Lite supports structured output and has a free tier with rate limits.
GEMINI_MODEL=gemini-3.5-flash-lite
# SQLite is used by default; an absolute path can also be supplied.
DATABASE_URL=sqlite:///./syllabussync.db
# Long random string used to sign session tokens. Required in production.
JWT_SECRET=
# Web client ID from Google Cloud Console (OAuth 2.0). Leave blank to hide Google sign-in.
GOOGLE_CLIENT_ID=
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,https://syllabus-sync-omega.vercel.app
